#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        hml: homerow_mods_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        rctrl {
            bindings = <&kp RCTRL>;
            key-positions = <6 7 8>;
        };

        lctrl {
            bindings = <&kp LCTRL>;
            key-positions = <1 2 3>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12 13>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <16 17 18>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
            &mt NUMBER_1 Q  &mt NUMBER_2 W  &mt NUMBER_3 F  &mt NUMBER_4 P  &mt NUMBER_5 B    &mt NUMBER_6 J  &mt N7 L       &mt NUMBER_8 U  &mt NUMBER_9 Y  &mt NUMBER_0 SEMICOLON
            &kp A           &kp R           &kp S           &kp T           &kp G             &kp M           &kp N          &kp E           &kp I           &kp O
&kp LSHIFT  &kp Z           &kp X           &kp C           &kp D           &kp V             &kp K           &kp H          &kp COMMA       &kp DOT         &kp SLASH               &kp RSHIFT
                                            &kp LEFT_GUI    &kp SPACE       &mo 1             &mo 2           &kp BACKSPACE  &kp RIGHT_ALT
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
        &kp GRAVE  &trans  &trans  &trans  &trans    &trans    &trans    &trans   &trans     &trans
        &trans     &trans  &trans  &trans  &trans    &kp LEFT  &kp DOWN  &kp UP   &kp RIGHT  &kp RIGHT
&trans  &trans     &trans  &trans  &trans  &trans    &trans    &trans    &trans   &trans     &trans     &trans
                           &trans  &trans  &trans    &trans    &trans    &kp DOT
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
        &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp LEFT_BRACE          &kp RIGHT_BRACE        &kp BACKSLASH  &kp KP_ASTERISK  &kp SQT  &kp DQT
        &trans    &trans  &trans    &trans      &kp LEFT_BRACKET        &kp RIGHT_BRACKET      &kp MINUS      &trans           &trans   &trans
&trans  &trans    &trans  &trans    &trans      &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp EQUAL      &trans           &trans   &kp SLASH  &kp HOME
                          &trans    &trans      &kp ESCAPE              &trans                 &trans         &trans
            >;
        };

        Fun {
            display-name = "Fun";
            bindings = <
        &bootloader  &trans  &trans  &trans  &to 4     &trans  &trans  &trans  &kp END  &kp F1
        &trans       &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &kp F10
&trans  &trans       &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &kp F20  &kp F7
                             &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        Gaming {
            display-name = "Gaming";
            bindings = <
            &kp Z           &kp X  &kp C      &kp V         &sl 0     &trans  &trans  &trans  &trans  &trans
            &kp TAB         &kp Q  &kp W      &kp E         &kp R     &trans  &trans  &trans  &trans  &trans
&kp ESCAPE  &kp LEFT_SHIFT  &kp A  &kp S      &kp D         &kp F     &trans  &trans  &trans  &trans  &trans  &trans
                                   &kp LCTRL  &kp LEFT_ALT  &trans    &trans  &trans  &trans
            >;
        };
    };
};
